# Discord bot token and the application's ID from Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: install slash commands only in a test server
DISCORD_GUILD_ID=
# Base64-encoded 32-byte local encryption key (openssl rand -base64 32)
DISCORD_RESPONSE_KEY=
# Use a dedicated PostgreSQL database. The migration role must own it.
DATABASE_URL=

# API keys for selecting and searching for memes
GEMINI_API_KEY=
BRAVE_SEARCH_API_KEY=
# Optional: override gemini-3.5-flash-lite
GEMINI_MODEL=
# Enable only after reviewing the Gemini data terms for actual Discord messages.
MEME_DISCORD_ENABLED=false
# Show image search previews only to the person who runs /밈.
MEME_DISCORD_SEARCH_PREVIEW=false
