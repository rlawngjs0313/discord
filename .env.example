# Discord bot token and the application's ID from Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: install slash commands only in a test server
DISCORD_GUILD_ID=
# Base64-encoded 32-byte local encryption key (openssl rand -base64 32)
DISCORD_RESPONSE_KEY=
# Use a dedicated PostgreSQL database. The migration role must own it.
DATABASE_URL=
